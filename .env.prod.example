# TaskFlow production runtime
NODE_ENV=production
HTTPS_PORT=443
TLS_CERT_DIR=./.taskflow/tls

# Set DOMAIN to enable automatic Let's Encrypt issuance via `make prod-up`
# (requires port 80 to be reachable at that domain). Leave unset to keep
# using the self-signed certificate.
# DOMAIN=example.com
# CERTBOT_EMAIL=you@example.com

# Production database. Replace every credential before deployment.
POSTGRES_USER=taskflow_prod
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=taskflow_prod
DATABASE_URL=postgresql://taskflow_prod:replace-with-a-strong-database-password@postgres:5432/taskflow_prod

# Seed execution stays disabled in production.
ALLOW_DB_SEED=false

# Replace localhost with the deployed HTTPS origin when a domain is connected.
APP_ORIGIN=https://localhost
GOOGLE_CLIENT_ID=replace-with-your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-client-secret
GOOGLE_REDIRECT_URI=https://localhost/oauth/google
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
OAUTH_AUTO_LINK_VERIFIED_EMAIL=false

# SMTP for email invitations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="TaskFlow <noreply@yourdomain.com>"

# WebSocket defaults
WS_AUTH_TIMEOUT_MS=10000
WS_HEARTBEAT_INTERVAL_MS=30000
WS_MAX_PAYLOAD_BYTES=65536
WS_MAX_MESSAGES_PER_MINUTE=120
