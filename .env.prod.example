# TaskFlow 운영 실행 환경
NODE_ENV=production
HTTPS_PORT=443
TLS_CERT_DIR=./.taskflow/tls

# DOMAIN을 설정하면 `make prod-up`이 Let's Encrypt 인증서 발급을 시도한다.
# 해당 도메인의 80번 포트로 접근할 수 있어야 하며, 비워두면 self-signed 인증서를 사용한다.
# DOMAIN=example.com
# CERTBOT_EMAIL=you@example.com
# SSH_TUNNEL_HOST에는 ~/.ssh/config의 Host 별칭을 넣고 IdentityFile 기반 인증을 사용한다.
# 현재 reverse forwarding은 VPS의 privileged port 80/443에 bind하므로 표준 OpenSSH에서는
# 일반적으로 원격 root 로그인이 필요하다. 권한을 제한한 전용 tunnel key를 사용한다.
# 값이 있으면 certbot 실행 동안만 아래 터널을 열고 발급/갱신 직후 닫는다.
# `ssh -R 80:localhost:$LOCAL_HTTP_PORT $SSH_TUNNEL_HOST`
# SSH_TUNNEL_HOST=tunnel
# LOCAL_HTTP_PORT=8080

# 운영 데이터베이스. 배포 전에 모든 credential을 교체한다.
POSTGRES_USER=taskflow_prod
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=taskflow_prod
DATABASE_URL=postgresql://taskflow_prod:replace-with-a-strong-database-password@postgres:5432/taskflow_prod

# 운영에서는 예제 데이터 seed를 항상 비활성화한다.
ALLOW_DB_SEED=false

# 도메인을 연결하면 localhost를 실제 HTTPS origin으로 교체한다.
APP_ORIGIN=https://localhost
GOOGLE_CLIENT_ID=replace-with-your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-client-secret
GOOGLE_REDIRECT_URI=https://localhost/oauth/google
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
OAUTH_AUTO_LINK_VERIFIED_EMAIL=false

# 이메일 초대 발송용 SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="TaskFlow <noreply@yourdomain.com>"

# WebSocket 기본값
WS_AUTH_TIMEOUT_MS=10000
WS_HEARTBEAT_INTERVAL_MS=30000
WS_MAX_PAYLOAD_BYTES=65536
WS_MAX_MESSAGES_PER_MINUTE=120
