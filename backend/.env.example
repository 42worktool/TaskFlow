# SMTP for email invitations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="TaskFlow <noreply@yourdomain.com>"

# Test recipient for the mailer smoke test
TEST_EMAIL_TO=you@example.com

# WebSocket defaults
WS_AUTH_TIMEOUT_MS=10000
WS_HEARTBEAT_INTERVAL_MS=30000
WS_MAX_PAYLOAD_BYTES=65536
WS_MAX_MESSAGES_PER_MINUTE=120
