{
  "name": "backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch index.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "typecheck:realtime-tests": "tsc -p src/realtime/tsconfig.test.json",
    "test": "npm run typecheck:realtime-tests && tsx --test src/app.integration.test.ts src/modules/auth/*.test.ts src/modules/card/*.test.ts src/modules/dashboard/*.test.ts src/modules/friend/*.test.ts src/modules/list/*.test.ts src/modules/notification/*.test.ts src/modules/presence/*.test.ts src/modules/profile/*.test.ts src/modules/workspace/*.test.ts src/lib/*.test.ts src/middleware/*.test.ts src/realtime/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --ignore-path ../.prettierignore --write .",
    "format:check": "prettier --ignore-path ../.prettierignore --check .",
    "knip": "knip",
    "db:generate": "prisma generate --schema ./prisma",
    "db:migrate": "prisma migrate deploy --schema ./prisma",
    "migrate": "prisma migrate deploy --schema ./prisma",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --schema ./prisma --force && npm run db:seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "google-auth-library": "^10.9.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "prisma": "^6.19.3",
    "redis": "^6.1.0",
    "ws": "^8.21.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.1",
    "@types/ws": "^8.18.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.9.0",
    "knip": "^6.31.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
