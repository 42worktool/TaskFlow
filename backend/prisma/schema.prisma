// ============================================================
// schema.prisma — DB 스키마 (팀 DBML 페이지가 원본, 여기는 구현체)
//
// 컨벤션:
//  - 테이블명: DBML 그대로 PascalCase 복수형 → @@map("Users")
//  - 컬럼명: DBML 그대로 snake_case (DTO도 snake_case라 통일)
//  - uuid PK: DB가 생성 (postgres 15의 gen_random_uuid())
//  - 업무 데이터 모델은 필요한 경우 created/updated/deleted 감사 컬럼을 사용
//  - *_by는 사용자 삭제 후에도 이력을 보존하기 위해 FK를 두지 않음
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

// 서비스 사용자. 이메일/비밀번호 가입과 OAuth 가입을 모두 지원하며,
// OAuth 전용 유저는 password_hash가 null이다.
model User {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email             String    @unique
  password_hash     String? // OAuth 전용 유저는 null
  name              String
  profile_image_url String?
  created_at        DateTime  @default(now())
  created_by        String?   @db.Uuid
  updated_at        DateTime  @default(now()) @updatedAt
  updated_by        String?   @db.Uuid
  deleted_at        DateTime? @db.Timestamptz(3)
  deleted_by        String?   @db.Uuid

  oauth_accounts       OAuthAccount[]
  memberships          WorkspaceMember[]
  cards                Card[]
  card_members         CardMember[]
  comments             Comment[]
  friendships_low      Friendship[]       @relation("FriendshipLow")
  friendships_high     Friendship[]       @relation("FriendshipHigh")
  friend_requests_low  FriendRequest[]    @relation("FriendRequestLow")
  friend_requests_high FriendRequest[]    @relation("FriendRequestHigh")
  workspace_messages   WorkspaceMessage[]

  @@map("Users")
}

// 방향 없는 전역 친구 관계. 두 사용자 ID를 정렬해 한 행만 저장한다.
// 수락된 관계만 이 테이블에 저장한다.
model Friendship {
  user_low_id  String   @db.Uuid
  user_high_id String   @db.Uuid
  created_at   DateTime @default(now()) @db.Timestamptz(3)

  user_low  User @relation("FriendshipLow", fields: [user_low_id], references: [id], onDelete: Cascade)
  user_high User @relation("FriendshipHigh", fields: [user_high_id], references: [id], onDelete: Cascade)

  @@id([user_low_id, user_high_id])
  @@index([user_high_id])
  @@map("Friendships")
}

// 대기 중인 친구 요청. 두 사용자 ID를 정렬한 복합 키로 양방향 중복
// 요청을 막고, requested_by_id로 요청을 보낸 사용자를 구분한다.
// 수락 또는 거절 시 행을 삭제하는 Toy 프로토타입 구조다.
model FriendRequest {
  user_low_id     String   @db.Uuid
  user_high_id    String   @db.Uuid
  requested_by_id String   @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(3)

  user_low  User @relation("FriendRequestLow", fields: [user_low_id], references: [id], onDelete: Cascade)
  user_high User @relation("FriendRequestHigh", fields: [user_high_id], references: [id], onDelete: Cascade)

  @@id([user_low_id, user_high_id])
  @@index([user_high_id])
  @@map("FriendRequests")
}

// 유저에 연결된 OAuth 계정. (provider, provider_id) 조합으로
// 소셜 로그인 시 기존 유저를 식별한다. 팀 결정: google 단일 provider.
model OAuthAccount {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @db.Uuid
  provider    String // "google" (팀 결정: google 단일)
  provider_id String // provider가 부여한 사용자 고유 ID (sub)
  created_at  DateTime  @default(now())
  created_by  String?   @db.Uuid
  updated_at  DateTime  @default(now()) @updatedAt
  updated_by  String?   @db.Uuid
  deleted_at  DateTime? @db.Timestamptz(3)
  deleted_by  String?   @db.Uuid

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([provider, provider_id])
  @@map("OAuthAccounts")
}

// 칸반 보드의 최상위 단위. 리스트/라벨/멤버가 모두 워크스페이스에 속하며,
// 워크스페이스 삭제 시 하위 데이터는 전부 cascade 삭제된다.
model Workspace {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String
  is_public  Boolean   @default(false)
  created_at DateTime  @default(now())
  created_by String?   @db.Uuid
  updated_at DateTime  @default(now()) @updatedAt
  updated_by String?   @db.Uuid
  deleted_at DateTime? @db.Timestamptz(3)
  deleted_by String?   @db.Uuid

  members  WorkspaceMember[]
  lists    List[]
  labels   Label[]
  messages WorkspaceMessage[]

  @@index([deleted_at])
  @@map("Workspaces")
}

// 워크스페이스-유저 멤버십 (M:N 조인 테이블). 복합 PK로 중복 가입을 막고,
// role로 워크스페이스 내 권한(OWNER/ADMIN/MEMBER/VIEWER)을 구분한다.
model WorkspaceMember {
  workspace_id String    @db.Uuid
  user_id      String    @db.Uuid
  role         Role
  created_at   DateTime  @default(now())
  created_by   String?   @db.Uuid
  updated_at   DateTime  @default(now()) @updatedAt
  updated_by   String?   @db.Uuid
  deleted_at   DateTime? @db.Timestamptz(3)
  deleted_by   String?   @db.Uuid

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([workspace_id, user_id])
  @@index([workspace_id, deleted_at])
  @@index([user_id, deleted_at])
  @@map("WorkspaceMembers")
}

// 워크스페이스 기본 채팅방의 메시지. 워크스페이스마다 방을 하나만 두는
// 프로토타입 범위이므로 별도 채팅방 테이블 없이 메시지를 바로 연결한다.
model WorkspaceMessage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String   @db.Uuid
  user_id      String   @db.Uuid
  card_id      String?  @db.Uuid
  content      String   @db.Text
  created_at   DateTime @default(now()) @db.Timestamptz(3)

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  card      Card?     @relation(fields: [card_id], references: [id], onDelete: SetNull)

  @@index([workspace_id, created_at])
  @@index([card_id])
  @@map("WorkspaceMessages")
}

// 보드의 세로 칼럼 (To Do / In Progress / Done 등).
// sequence는 fractional indexing용 Float — 두 리스트 사이 값을 부여해
// 드래그 앤 드롭 순서 변경 시 전체 재정렬 없이 위치를 바꾼다.
model List {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String    @db.Uuid
  name         String
  sequence     Float
  is_done      Boolean   @default(false)
  created_at   DateTime  @default(now())
  created_by   String?   @db.Uuid
  updated_at   DateTime  @default(now()) @updatedAt
  updated_by   String?   @db.Uuid
  deleted_at   DateTime? @db.Timestamptz(3)
  deleted_by   String?   @db.Uuid

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  cards Card[]

  @@index([workspace_id, deleted_at])
  @@map("Lists")
}

// 칸반 카드. list_id가 null이면 개인 inbox 카드, 있으면 보드 카드.
// 리스트/유저 삭제 시 카드는 지우지 않고 SetNull로 inbox에 남긴다 (팀 결정).
// sequence는 List와 동일한 fractional indexing 방식.
model Card {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  list_id     String?   @db.Uuid
  user_id     String?   @db.Uuid
  title       String
  description String    @db.Text
  start_at    DateTime?
  deadline    DateTime?
  sequence    Float
  created_at  DateTime  @default(now())
  created_by  String?   @db.Uuid
  updated_at  DateTime  @default(now()) @updatedAt
  updated_by  String?   @db.Uuid
  deleted_at  DateTime? @db.Timestamptz(3)
  deleted_by  String?   @db.Uuid

  list List? @relation(fields: [list_id], references: [id], onDelete: SetNull) //인박스에 들어가는 경우 null이 가능해서 set null
  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull) //인박스에 들어가는 경우 null이 가능해서 set null

  card_members       CardMember[]
  card_labels        CardLabel[]
  attachments        Attachment[]
  comments           Comment[]
  workspace_messages WorkspaceMessage[]

  @@index([list_id, deleted_at])
  @@map("Cards")
}

// 카드 담당자 (M:N 조인 테이블). 카드 하나에 여러 유저를 배정할 수 있다.
model CardMember {
  card_id    String    @db.Uuid
  user_id    String    @db.Uuid
  created_at DateTime  @default(now())
  created_by String?   @db.Uuid
  updated_at DateTime  @default(now()) @updatedAt
  updated_by String?   @db.Uuid
  deleted_at DateTime? @db.Timestamptz(3)
  deleted_by String?   @db.Uuid

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([card_id, user_id])
  @@map("CardMembers")
}

// 워크스페이스 단위로 정의하는 라벨 (이름 + 색상).
// 같은 워크스페이스의 카드들이 공유한다.
model Label {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspace_id String    @db.Uuid
  label_name   String
  label_color  String
  created_at   DateTime  @default(now())
  created_by   String?   @db.Uuid
  updated_at   DateTime  @default(now()) @updatedAt
  updated_by   String?   @db.Uuid
  deleted_at   DateTime? @db.Timestamptz(3)
  deleted_by   String?   @db.Uuid

  workspace Workspace @relation(fields: [workspace_id], references: [id], onDelete: Cascade)

  card_Labels CardLabel[]

  @@map("Labels")
}

// 카드-라벨 연결 (M:N 조인 테이블).
model CardLabel {
  label_id   String    @db.Uuid
  card_id    String    @db.Uuid
  created_at DateTime  @default(now())
  created_by String?   @db.Uuid
  updated_at DateTime  @default(now()) @updatedAt
  updated_by String?   @db.Uuid
  deleted_at DateTime? @db.Timestamptz(3)
  deleted_by String?   @db.Uuid

  label Label @relation(fields: [label_id], references: [id], onDelete: Cascade)
  card  Card  @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@id([label_id, card_id])
  @@map("CardLabels")
}

// 카드 첨부파일. 파일 자체는 외부 스토리지에 두고 URL만 저장한다.
model Attachment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  card_id    String    @db.Uuid
  file_url   String?
  file_name  String?
  created_at DateTime  @default(now())
  created_by String?   @db.Uuid
  updated_at DateTime  @default(now()) @updatedAt
  updated_by String?   @db.Uuid
  deleted_at DateTime? @db.Timestamptz(3)
  deleted_by String?   @db.Uuid

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)

  @@map("Attachments")
}

// 카드에 달리는 댓글.
model Comment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  card_id     String    @db.Uuid
  user_id     String    @db.Uuid
  comment_str String
  created_at  DateTime  @default(now())
  created_by  String?   @db.Uuid
  updated_at  DateTime  @default(now()) @updatedAt
  updated_by  String?   @db.Uuid
  deleted_at  DateTime? @db.Timestamptz(3)
  deleted_by  String?   @db.Uuid

  card Card @relation(fields: [card_id], references: [id], onDelete: Cascade)
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([card_id, deleted_at])
  @@map("Comments")
}
