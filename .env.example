# Google OAuth web client. Keep the actual client secret in the ignored .env file.
GOOGLE_CLIENT_ID=709456664375-8iph706n8tl17i8qrip3oq1gn6nl2qgd.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-client-secret

# This matches the current Google Cloud local redirect URI.
GOOGLE_REDIRECT_URI=https://localhost:4430/oauth/google
APP_ORIGIN=https://localhost:4430

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters

# Toy project: link an existing local user when Google confirms the same email.
OAUTH_AUTO_LINK_VERIFIED_EMAIL=true
