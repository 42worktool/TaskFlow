# TaskFlow development runtime
NODE_ENV=development
HTTPS_PORT=4430

# Development database
POSTGRES_USER=taskflow_dev
POSTGRES_PASSWORD=dev-password
POSTGRES_DB=taskflow_dev
DATABASE_URL=postgresql://taskflow_dev:dev-password@postgres:5432/taskflow_dev

# Explicit development seed settings
ALLOW_DB_SEED=true
DEV_SEED_EMAIL=dev@local.test
DEV_SEED_PASSWORD=DevPassword123!

# Google OAuth web client. Keep the actual client secret in the ignored .env.dev file.
GOOGLE_CLIENT_ID=replace-with-your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-your-client-secret

# This matches the current Google Cloud local redirect URI.
GOOGLE_REDIRECT_URI=https://localhost:4430/oauth/google
APP_ORIGIN=https://localhost:4430

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters

# SMTP for email invitations
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="TaskFlow <noreply@yourdomain.com>"

# Toy project: link an existing local user when Google confirms the same email.
OAUTH_AUTO_LINK_VERIFIED_EMAIL=true

# WebSocket defaults. Tune these only when deployment requirements differ.
WS_AUTH_TIMEOUT_MS=10000
WS_HEARTBEAT_INTERVAL_MS=30000
WS_MAX_PAYLOAD_BYTES=65536
WS_MAX_MESSAGES_PER_MINUTE=120
